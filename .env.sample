#######################################################################
# Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
#
# NEVER commit .env to version control - it contains secrets!
#######################################################################

#######################################################################
# REQUIRED: AI Developer Workflow (ADW) Configuration
#######################################################################

# Anthropic API Key (REQUIRED for Claude Code)
# Get your key from: https://console.anthropic.com/
# Used for: Running Claude Code CLI in programmatic mode
ANTHROPIC_API_KEY=

# GitHub Repository URL (REQUIRED for ADW)
# Format: https://github.com/owner/repository
# Used for: ADW issue processing, PR creation, branch management
GITHUB_REPO_URL=

#######################################################################
# OPTIONAL: GitHub Configuration
#######################################################################

# GitHub Personal Access Token (OPTIONAL)
# Only needed if you want ADW to use a different GitHub account
# than your default 'gh auth login' account.
# Get a token from: https://github.com/settings/tokens
# Scopes needed: repo, workflow
# If not set, ADW uses whichever account is authenticated via 'gh auth login'
GITHUB_PAT=

#######################################################################
# OPTIONAL: Claude Code Configuration
#######################################################################

# Claude Code CLI Path (OPTIONAL)
# Path to the Claude Code executable
# Default: "claude" (searches PATH)
# Use this if 'claude' is not in your PATH or you have multiple versions
# Find with: which claude
CLAUDE_CODE_PATH=claude

# Claude Code Working Directory Behavior (OPTIONAL)
# When true, returns Claude Code to project root after every command
# Default: true
# Helps maintain consistent working directory across operations
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true

#######################################################################
# OPTIONAL: Cloud Sandboxing (E2B)
#######################################################################

# E2B API Key (OPTIONAL)
# Used for running code in isolated cloud sandbox environments
# Get your key from: https://e2b.dev/
# Only needed if you want to use E2B sandboxing features
# See: ai_docs/e2b.md for more information
E2B_API_KEY=

#######################################################################
# OPTIONAL: Webhook Tunneling (Cloudflare)
#######################################################################

# Cloudflare Tunnel Token (OPTIONAL)
# Used to expose local webhook server (trigger_webhook.py) to the internet
# Required for: Receiving GitHub webhooks during local development
# Get from: https://dash.cloudflare.com/
# See: scripts/expose_webhook.sh for usage
# Not needed if using cron-based trigger or deploying webhook to server
CLOUDFLARED_TUNNEL_TOKEN=

#######################################################################
# APPLICATION-SPECIFIC VARIABLES
#
# Add your own application environment variables below.
# Examples for common use cases:
#######################################################################

# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20

# API Keys (External Services)
# STRIPE_API_KEY=sk_test_xxxxx
# SENDGRID_API_KEY=SG.xxxxx
# OPENAI_API_KEY=sk-xxxxx
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx

# Application Settings
# APP_NAME=My Application
# APP_VERSION=0.1.0
# DEBUG=false
# LOG_LEVEL=INFO
# PORT=8000
# HOST=0.0.0.0

# Feature Flags
# ENABLE_ANALYTICS=true
# ENABLE_CACHING=false
# MAINTENANCE_MODE=false

# Security
# JWT_SECRET=your-secret-key-here
# ENCRYPTION_KEY=your-encryption-key-here
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis/Cache
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# Email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourapp.com

# File Storage
# S3_BUCKET=your-bucket-name
# UPLOAD_DIR=/var/uploads
# MAX_FILE_SIZE=10485760

#######################################################################
# NOTES
#######################################################################

# Loading Environment Variables:
#
# Python (with python-dotenv):
#   from dotenv import load_dotenv
#   import os
#   load_dotenv()
#   api_key = os.getenv("ANTHROPIC_API_KEY")
#
# Node.js (with dotenv):
#   import 'dotenv/config';
#   const apiKey = process.env.ANTHROPIC_API_KEY;
#
# Shell Scripts:
#   source .env
#   echo $ANTHROPIC_API_KEY
#
# Security Best Practices:
# - Never commit .env files to version control
# - Use different .env files for dev/staging/production
# - Rotate secrets regularly
# - Use the principle of least privilege for API keys
# - Consider using a secrets manager in production
